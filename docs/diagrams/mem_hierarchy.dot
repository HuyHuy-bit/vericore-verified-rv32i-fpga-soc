digraph mem_hierarchy {
    rankdir=LR;
    graph [fontname="Helvetica", fontsize=11, bgcolor="white"];
    node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#4338ca"];
    edge  [fontname="Helvetica", fontsize=9, color="#555555"];

    cpu    [label="CPU\n(MEM stage)"];
    lsu    [label="lsu\nsubword load/store\nalignment"];
    dcache [label="dcache\nwrite-through / write-back\nparameterised geometry"];
    timing [label="mem_timing\naccess-cost model", fillcolor="#fef9c3", color="#a16207"];
    data   [label="data_mem\nbacking store"];

    cpu -> lsu -> dcache -> timing -> data;
    data -> timing -> dcache -> lsu -> cpu [label="  word(s)"];

    burst [label="burst refill: LATENCY cycles for the\nfirst word, 1 cycle per sequential word\nafter — this is what makes the\nblock-size sweep mean anything",
           shape=note, fillcolor="#fee2e2", color="#b91c1c", fontsize=9];
    dcache -> burst [style=dashed, color="#b91c1c", dir=none, constraint=false];
    burst -> timing [style=dashed, color="#b91c1c", constraint=false];
}
