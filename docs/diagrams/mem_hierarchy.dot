// Memory hierarchy of the legacy `cpu` wrapper: one request path, one return
// path, drawn as a single bidirectional link per hop. Black and white only.
digraph mem_hierarchy {
    rankdir=LR;
    bgcolor=white;
    graph [fontname="Helvetica", fontsize=10, nodesep=0.4, ranksep=0.7];
    node  [fontname="Helvetica", fontsize=10, shape=box, color=black,
           fontcolor=black];
    edge  [fontname="Helvetica", fontsize=9, color=black, fontcolor=black,
           arrowsize=0.7, dir=both];

    cpu    [label="CPU\n(MEM stage)"];
    lsu    [label="lsu\nsubword load/store\nalignment"];
    dcache [label="dcache\nwrite-through / write-back\nparameterised geometry"];
    timing [label="mem_timing\naccess-cost model"];
    data   [label="data_mem\nbacking store"];

    cpu -> lsu -> dcache -> timing -> data [label="word(s)"];

    label = "\nBurst refill: LATENCY cycles for the first word of a block, 1 cycle per sequential\l\
word after. That discount is what makes the block-size sweep meaningful.\l";
    labelloc = "b";
    labeljust = "l";
    fontsize = 9;
}
