digraph datapath {
    rankdir=LR;
    graph [fontname="Helvetica", fontsize=11, bgcolor="white", nodesep=0.35, ranksep=0.55];
    node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#4338ca"];
    edge  [fontname="Helvetica", fontsize=9, color="#555555"];

    // Stage clusters. IF is frontend.sv end to end; ID/EX/MEM/WB are all
    // inside backend.sv - if_id_q (the IF/ID register) is the one signal
    // that crosses that module boundary.
    subgraph cluster_if {
        label="IF  —  frontend.sv"; style=dashed; color="#1e3a8a"; fontcolor="#1e3a8a";
        pc     [label="PC"];
        icache [label="I-cache /\ninstr_mem"];
        bpred  [label="branch_predictor\nBTB + bimodal/gshare"];
        ras    [label="RAS\nreturn-addr stack"];
        {rank=same; pc; icache;}
        {rank=same; bpred; ras;}
    }
    subgraph cluster_id {
        label="ID  —  backend.sv"; style=dashed; color="#7c2d12"; fontcolor="#7c2d12";
        control [label="control"];
        regfile [label="reg_file"];
        immgen  [label="imm_gen"];
        hazard  [label="hazard_detect\n(load-use)"];
    }
    subgraph cluster_ex {
        label="EX"; style=dashed; color="#94a3b8";
        alu    [label="alu"];
        bunit  [label="branch_unit"];
        fwd    [label="forwarding_unit"];
    }
    subgraph cluster_mem {
        label="MEM — single commit point"; style=dashed; color="#94a3b8";
        lsu    [label="lsu"];
        dcache [label="dcache /\ndata_mem"];
        csr    [label="csr — trap +\ninterrupt commit\nmstatus/mie/mip/mtime",
                 fillcolor="#fee2e2", color="#b91c1c"];
    }
    subgraph cluster_wb {
        label="WB"; style=dashed; color="#94a3b8";
        wbmux  [label="writeback mux"];
    }

    ifid  [label="IF/ID", shape=box, style=filled, fillcolor="#fef9c3", color="#a16207"];
    idex  [label="ID/EX", shape=box, style=filled, fillcolor="#fef9c3", color="#a16207"];
    exmem [label="EX/MEM", shape=box, style=filled, fillcolor="#fef9c3", color="#a16207"];
    memwb [label="MEM/WB", shape=box, style=filled, fillcolor="#fef9c3", color="#a16207"];

    // Invisible backbone: forces the five stages to lay out strictly
    // left-to-right in pipeline order, regardless of how the feedback edges
    // below (forwarding, hazard, redirects) would otherwise pull the rank
    // assignment around. This is the fix for the tangled, IF-ends-up-at-
    // the-bottom layout the diagram had before.
    edge [style=invis];
    pc -> ifid -> control -> idex -> alu -> exmem -> lsu -> memwb -> wbmux;
    edge [style=solid];

    // ---- main pipeline flow ----
    pc -> icache;
    icache -> ifid [label="if_id_q", constraint=false];
    ifid -> regfile [constraint=false]; ifid -> immgen [constraint=false];
    regfile -> idex [constraint=false]; immgen -> idex [constraint=false];
    idex -> bunit [constraint=false];
    bunit -> exmem [constraint=false]; alu -> exmem [constraint=false];
    exmem -> dcache [constraint=false];
    exmem -> csr [label="trap/irq check", constraint=false];
    memwb -> wbmux [constraint=false];
    wbmux -> regfile [label="writeback", style=dashed, color="#16a34a", constraint=false];

    // ---- forwarding (detail, doesn't drive rank) ----
    exmem -> fwd [style=dashed, color="#2563eb", label="EX/MEM fwd", constraint=false];
    memwb -> fwd [style=dashed, color="#2563eb", label="MEM/WB fwd", constraint=false];
    fwd -> alu [style=dashed, color="#2563eb", constraint=false];

    // ---- hazard / stall ----
    idex -> hazard [style=dashed, color="#dc2626", constraint=false];
    hazard -> ifid [label="stall", style=dashed, color="#dc2626", constraint=false];
    hazard -> pc [label="stall", style=dashed, color="#dc2626", constraint=false];

    // ---- predictor training ----
    // EX resolves a branch/jump and hands the outcome back to the front
    // end's tables (bp_update_*). Calls/returns push/pop the RAS straight
    // from instr_if at fetch time instead (not shown) - it doesn't wait for
    // EX resolution the way BTB training does.
    bunit -> bpred [label="bp_update_*", color="#0891b2", fontcolor="#0891b2", style=dashed, constraint=false];

    // ---- redirects back to PC, priority annotated on the mux ----
    predmux [label="next-PC priority mux\nfreeze > trap/irq > mispredict\n> load-use stall > predict > +4",
             shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d"];
    bunit  -> predmux [label="EX mispredict redirect", color="#ea580c", fontcolor="#ea580c", constraint=false];
    csr    -> predmux [label="MEM trap/irq redirect", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
    bpred  -> predmux [label="BTB predict", color="#7c3aed", fontcolor="#7c3aed", style=dashed, constraint=false];
    ras    -> predmux [label="RAS predict (wins if valid)", color="#7c3aed", fontcolor="#7c3aed", style=dashed, constraint=false];
    predmux -> pc [label="next_pc", constraint=false];
}
