`verilator_config

// import rv32i_pkg::*; is deliberate: one shared package. The pipeline
// register modules import it for the payload struct types.
lint_off -rule IMPORTSTAR -file "*/alu.sv"
lint_off -rule IMPORTSTAR -file "*/control.sv"
lint_off -rule IMPORTSTAR -file "*/csr.sv"
lint_off -rule IMPORTSTAR -file "*/imm_gen.sv"
lint_off -rule IMPORTSTAR -file "*/branch_unit.sv"
lint_off -rule IMPORTSTAR -file "*/lsu.sv"
lint_off -rule IMPORTSTAR -file "*/if_id_reg.sv"
lint_off -rule IMPORTSTAR -file "*/id_ex_reg.sv"
lint_off -rule IMPORTSTAR -file "*/ex_mem_reg.sv"
lint_off -rule IMPORTSTAR -file "*/mem_wb_reg.sv"
lint_off -rule IMPORTSTAR -file "*/frontend.sv"
lint_off -rule IMPORTSTAR -file "*/backend.sv"
lint_off -rule IMPORTSTAR -file "*/instr_mem.sv"
lint_off -rule IMPORTSTAR -file "*/data_mem.sv"
lint_off -rule IMPORTSTAR -file "*/icache.sv"
lint_off -rule IMPORTSTAR -file "*/dcache.sv"
lint_off -rule IMPORTSTAR -file "*/mem_timing.sv"
lint_off -rule IMPORTSTAR -file "*/branch_predictor.sv"
lint_off -rule IMPORTSTAR -file "*/ras.sv"
lint_off -rule IMPORTSTAR -file "*/pc.sv"
lint_off -rule IMPORTSTAR -file "*/reg_file.sv"
lint_off -rule IMPORTSTAR -file "*/perf_counters.sv"
lint_off -rule IMPORTSTAR -file "*/cpu.sv"
lint_off -rule IMPORTSTAR -file "*/rv32i_core.sv"

lint_off -rule UNUSEDSIGNAL -file "*/cpu.sv" -match "*retired_debug*"

// ex_mem_q.csr_rdata is latched for a future CSR-forwarding path, not read
// yet. Reported against the whole packed struct, hence the bit-range match.
lint_off -rule UNUSEDSIGNAL -file "*/backend.sv" -match "*'ex_mem_q'*"

// idx_of/tag_of intentionally slice disjoint bit ranges of pc; each function
// only touches the bits it needs.
lint_off -rule UNUSEDSIGNAL -file "*/branch_predictor.sv" -match "*'pc'*"

// funct7 bit 5 and 6 are unused by RV32I base decode; kept for forward compat.
lint_off -rule UNUSEDSIGNAL -file "*/control.sv" -match "*funct7*"

// CAUSE_MISALIGNED_FETCH is declared ahead of the misaligned-fetch trap
// implementation (tracked in the improvement plan, Phase 8).
lint_off -rule UNUSEDPARAM -file "*/rv32i_pkg.sv" -match "*CAUSE_MISALIGNED_FETCH*"

// clk/rst/req/burst/addr fold out of mem_timing at the default LATENCY=1
// elaboration used for plain `make lint`; they're live at LATENCY>1.
lint_off -rule UNUSEDSIGNAL -file "*/mem_timing.sv"

// csr_read_only(addr) intentionally only inspects addr[11:10]; the standard
// RISC-V read-only-CSR convention.
lint_off -rule UNUSEDSIGNAL -file "*/rv32i_pkg.sv" -match "*'addr'*"

// The rvfi_* retirement trace has no in-RTL consumer by design - tb/lockstep.cpp
// reads it by hierarchy. Unused inside cpu.sv is the intended state.
lint_off -rule UNUSEDSIGNAL -file "*/backend.sv" -match "*rvfi_*"
// tohost_* is read by the testbench by hierarchy; no RTL consumer by design.
lint_off -rule UNUSEDSIGNAL -file "*/backend.sv" -match "*tohost_*"
